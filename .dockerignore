# Secrets — never bake into image
.env

# Virtual environment
.venv/

# Local database — mounted as volume at runtime
data/

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/

# Git
.git/
.gitignore

# Editor / OS
.DS_Store
*.swp
*.swo

# React — node_modules are installed inside the Docker build stage, not from host
frontend-react/node_modules/
# Built output is produced by the Docker build stage, not copied from host
frontend-react/dist/

# Tests — not needed at runtime
tests/

# Planning docs (not needed at runtime)
opus_plan_src_files/
Phase_Task_Breakdowns.md
