# Whoop OAuth credentials
# Register your app at https://developer.whoop.com
WHOOP_CLIENT_ID=your_whoop_client_id_here
WHOOP_CLIENT_SECRET=your_whoop_client_secret_here
WHOOP_REDIRECT_URI=http://localhost:8000/api/auth/whoop/callback

# Garmin Personal API key (official API). Create one at
# https://connect.garmin.com/app/settings/personalApiToken
# Choose a 365-day expiry so the key rarely needs rotating.
GARMIN_PERSONAL_API_KEY=
# How often the background scheduler polls Garmin for new data (minutes)
GARMIN_POLL_INTERVAL_MINUTES=30

# Database
# Local development (default):
DATABASE_URL=sqlite:///data/fitness_dashboard.db
# Production (Supabase PostgreSQL — use the session pooler URL from Project Settings → Database):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Server ports
APP_PORT=8000
STREAMLIT_PORT=8501

# JWT Authentication
# Generate a secure secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_ALGORITHM=HS256

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Admin email — used as the Bearer token for GET /api/waitlist/admin
ADMIN_EMAIL=
